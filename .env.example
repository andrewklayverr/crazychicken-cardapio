DATABASE_URL=mysql://USUARIO:SENHA@HOST:3306/BANCO
DB_SSL=false
DB_CONNECTION_LIMIT=5

# Use um caminho absoluto e persistente, fora de hbuilds/source/repository.
UPLOAD_DIR=/home/USUARIO_HOSTINGER/domains/SEU_DOMINIO/uploads

# Separe mais de um e-mail por vírgula.
ADMIN_EMAILS=seu-email@dominio.com
# Gere com: npm run auth:hash -- "uma-senha-forte"
ADMIN_PASSWORD_HASH=scrypt$COLOQUE_AQUI_O_SALT$COLOQUE_AQUI_O_HASH
# Gere um valor aleatório com pelo menos 32 caracteres e nunca reutilize uma senha.
AUTH_SECRET=
# Compatibilidade temporária. Mantenha false após criar contas individuais.
ALLOW_LEGACY_ADMIN_AUTH=false
MFA_ENCRYPTION_KEY=chave-aleatoria-de-32-bytes-em-hexadecimal
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=Crazy Chicken <noreply@crazychicken247.com.br>
# ID do template publicado no Resend usado pelos convites da equipe.
RESEND_INVITE_TEMPLATE_ID=seu-id-do-template-no-resend
APP_URL=https://crazychicken247.com.br
ADMIN_SETUP_CODE=gere-um-codigo-longo-e-unico
ADMIN_SETUP_EXPIRES_AT=2026-12-31T23:59:59.000Z

# PIX Mercado Pago. Use primeiro o Access Token de teste do vendedor.
# As credenciais existem somente no servidor e nunca usam o prefixo NEXT_PUBLIC_.
MERCADO_PAGO_ACCESS_TOKEN=
# Copie a assinatura secreta gerada ao salvar o webhook Order (Mercado Pago).
MERCADO_PAGO_WEBHOOK_SECRET=
# Validade da cobranca em segundos (30 minutos a 30 dias).
MERCADO_PAGO_PIX_EXPIRES_IN=1800

NODE_ENV=production

# Recuperacao temporaria do proprietario. Remova apos confirmar o login.
ADMIN_RECOVERY_EMAIL=rodrigostuarth@hotmail.com
ADMIN_RECOVERY_CODE=
ADMIN_RECOVERY_EXPIRES_AT=
