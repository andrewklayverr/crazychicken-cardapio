DATABASE_URL=mysql://USUARIO:SENHA@HOST:3306/BANCO
DB_SSL=false
DB_CONNECTION_LIMIT=5

# Use um caminho persistente da Hostinger para não perder uploads em novo deploy.
UPLOAD_DIR=./public/uploads

# Separe mais de um e-mail por vírgula.
ADMIN_EMAILS=seu-email@dominio.com
# Gere com: npm run auth:hash -- "uma-senha-forte"
ADMIN_PASSWORD_HASH=scrypt$COLOQUE_AQUI_O_SALT$COLOQUE_AQUI_O_HASH
AUTH_SECRET=troque-por-um-segredo-longo-e-aleatorio
MFA_ENCRYPTION_KEY=chave-aleatoria-de-32-bytes-em-hexadecimal
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=Crazy Chicken <noreply@crazychiken.com.br>
APP_URL=https://crazychiken.com.br
ADMIN_SETUP_CODE=gere-um-codigo-longo-e-unico
ADMIN_SETUP_EXPIRES_AT=2026-12-31T23:59:59.000Z

NODE_ENV=production
